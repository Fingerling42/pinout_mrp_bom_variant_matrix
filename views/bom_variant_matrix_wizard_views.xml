<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_variant_matrix_wizard_view_form" model="ir.ui.view">
        <field name="name">mrp.bom.variant.matrix.wizard.form</field>
        <field name="model">mrp.bom.variant.matrix.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Variant Matrix">
                <sheet>
                    <group>
                        <group>
                            <field name="bom_id" readonly="1" force_save="1"/>
                            <field name="product_tmpl_id" readonly="1"/>
                            <field name="component_axis_attribute_id"/>
                            <field name="quantity_axis_attribute_id"/>
                            <field name="product_uom_id"/>
                        </group>
                        <group>
                            <field name="mode"/>
                            <field name="create_sections"/>
                            <field
                                name="section_by_component_axis"
                                invisible="not create_sections"
                            />
                            <field name="matrix_key"/>
                            <field name="sequence_start"/>
                            <field name="sequence_step"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Component Mapping" name="component_mapping">
                            <field name="component_mapping_line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="ptav_id" readonly="1" force_save="1"/>
                                    <field name="attribute_id" readonly="1"/>
                                    <field name="component_product_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Quantity Mapping" name="quantity_mapping">
                            <field name="quantity_mapping_line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="ptav_id" readonly="1" force_save="1"/>
                                    <field name="attribute_id" readonly="1"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Preview" name="preview">
                            <field name="preview_line_ids" readonly="1">
                                <tree>
                                    <field name="component_axis_ptav_id"/>
                                    <field name="quantity_axis_ptav_id"/>
                                    <field name="component_product_id"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id"/>
                                    <field name="apply_ptav_ids" widget="many2many_tags"/>
                                    <field name="existing_bom_line_id"/>
                                    <field name="status"/>
                                    <field name="message"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button
                        name="action_preview"
                        string="Preview"
                        type="object"
                        class="btn-secondary"
                    />
                    <button
                        name="action_apply_matrix"
                        string="Apply Matrix"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
